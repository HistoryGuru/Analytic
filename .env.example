# --- Tabroom credentials (used for both the private API and HTML fallback scraping) ---
TABROOM_USERNAME=you@example.com
TABROOM_PASSWORD=changeme

# --- Opencaselist credentials ---
OPENCASELIST_USERNAME=you@example.com
OPENCASELIST_PASSWORD=changeme

# --- Groq (free-tier hosted LLM) ---
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile

# --- App config ---
# The Opencaselist "slug" for the current LD season, e.g. hsld26 for 2025-26.
CASELIST_SLUG=hsld26
# Season string for the Tournaments.Tech aggregator, e.g. SY_25_26 for 2025-26.
DEBATELAND_SEASON=SY_25_26
# Comma-separated list of circuits to try on Tournaments.Tech, in order.
DEBATELAND_CIRCUITS=National,Local
# How long (seconds) to cache a lookup result in memory before re-scraping.
CACHE_TTL_SECONDS=900
# Comma-separated list of allowed CORS origins for the future frontend.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
